# ⌨️ Ghostty keybindings

# 🗂️ Tabs
cmd+t                  # new tab
cmd+w                  # close tab or split
cmd+1..9               # switch to tab N
cmd+shift+left/right   # move tab

# 🔲 Splits
cmd+d                  # split right
cmd+shift+d            # split down
cmd+opt+arrows         # navigate splits
cmd+shift+enter        # zoom/unzoom split

# 🪟 Window
cmd+n                  # new window
cmd+enter              # toggle fullscreen
cmd+k                  # clear screen

# 🔍 Search & Font
cmd+f                  # search
cmd++ / cmd+-          # font size +/-
cmd+0                  # reset font size
