# 🗂️ chezmoi (dots) — dotfiles manager

# ✏️ Edit a tracked file
dots edit ~/.config/foo   # edit a managed file
dots cd                   # cd into source directory

# 🔄 Pull in manual changes
dots re-add               # sync all managed files from home

# ✅ Preview & apply
dots diff                 # show pending changes
dots apply                # apply source to home

# ➕ Track a new file
dots add ~/.config/foo

# 🔀 Commit & push
dots git status
dots git add -A
dots git commit -m "msg"
dots git push

# 🔍 Inspect
dots status               # show changed files
dots managed              # list all managed files
dots doctor               # check for issues
