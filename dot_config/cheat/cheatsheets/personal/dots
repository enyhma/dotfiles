# chezmoi (dots) — dotfiles manager

# Track a new file:
dots add ~/.config/foo

# Sync all managed files from home:
dots re-add

# Apply source to home:
dots apply

# Show pending changes:
dots diff

# Show changed files:
dots status

# Edit a managed file:
dots edit ~/.config/foo

# cd into source directory:
dots cd

# Run git in source directory:
dots git status
dots git add -A
dots git commit -m "msg"
dots git push

# Show template variables:
dots data

# Check for issues:
dots doctor

# List all managed files:
dots managed
