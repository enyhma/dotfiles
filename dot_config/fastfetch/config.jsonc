{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "none"
  },
  "modules": [
    "break",
    "os",
    "host",
    "uptime",
    "shell",
    "disk",
    "break",
    {
      "type": "command",
      "key": "",
      "text": "~/.config/fastfetch/scripts/cli-tools"
    },
    "break",
    {
      "type": "command",
      "key": "",
      "text": "printf '\\r\\033[2K\\033[2;37m↩ ref · ff · fastfetch\\033[0m'"
    }
  ]
}
